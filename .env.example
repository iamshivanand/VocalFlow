# VocalFlow Environment Configuration

# Server Port (default: 3001)
PORT=3001

# JWT Secret for Team Member Sessions
JWT_SECRET=vocalflow_secure_jwt_secret_change_in_production

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Hostinger Postgres, or Local Docker)
# Leave empty to automatically use local SQLite fallback during local development.
DATABASE_URL=postgresql://username:password@localhost:5432/vocalflow

# Optional: Set to production when deploying to Hostinger
NODE_ENV=development
